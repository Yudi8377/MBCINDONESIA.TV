# Salin ke .env di server produksi (JANGAN commit). chmod 600 .env
NODE_ENV=production
PORT=8080

# ── Database: SUPABASE (disarankan) ─────────────────────────────
# Supabase → Project Settings → Database → Connection string → Session pooler.
# Format: postgresql://postgres.<project-ref>:<SANDI>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Siapkan sekali dengan:  SUPABASE_DB_URL="..." node setup-supabase.js
SUPABASE_DB_URL=
PG_POOL_MAX=5

# ── Alternatif: Neon / Postgres terkelola (wajib sslmode=require untuk Neon) ──
# DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/mbctv?sslmode=require

# Wajib: buat dengan `openssl rand -hex 48`. Server menolak start di production bila kosong.
JWT_SECRET=

# Khusus docker-compose (abaikan bila memakai Neon)
POSTGRES_PASSWORD=
