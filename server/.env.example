# Salin ke lingkungan Anda dan isi nilai sebenarnya. JANGAN commit .env ke GitHub.

# Lokal (default dev): postgres lokal hasil apt
DATABASE_URL=postgres://mbc:mbc_dev_password@127.0.0.1:5432/mbctv

# Produksi — SUPABASE (disarankan). Ambil dari Supabase → Project Settings → Database →
# Connection string → "Session pooler" (IPv4). Ganti [YOUR-PASSWORD] dengan sandi database.
# SUPABASE_DB_URL=postgresql://postgres.abcdefghijklmno:RAHASIA@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
#
# Alternatif: Neon / Postgres terkelola lain (Blueprint §9.2)
# DATABASE_URL=postgres://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/mbctv?sslmode=require
#
# SUPABASE_DB_URL selalu diprioritaskan di atas DATABASE_URL (lihat db.js).

# Wajib di-set di produksi (openssl rand -hex 48)
JWT_SECRET=ganti-dengan-string-acak-panjang

# Port server (default 8080)
PORT=8080

# Ukuran pool koneksi (default 10)
PG_POOL_MAX=10
